#version 450
// PyroWave decode output -> BGRA: three full-size planes (Y, Cb, Cr) in
// full-range BT.709 with chroma centred at 128/255, as PyroWave's encoder
// writes them. Each source pixel is written as a zoom x zoom block, as in
// recombine.comp. `dst` is zoom * width by zoom * height.
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0) uniform sampler2D plane_y;
layout(set = 0, binding = 1) uniform sampler2D plane_cb;
layout(set = 0, binding = 2) uniform sampler2D plane_cr;
// `dst` is a BGRA image viewed as RGBA, so channels are stored as B,G,R,A.
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform Push { int width; int height; int unused; int zoom; } pc;

const float MID = 128.0 / 255.0;

vec3 to_rgb(float y, float cb, float cr) {
    cb -= MID;
    cr -= MID;
    return clamp(vec3(y + 1.5748 * cr, y - 0.187324 * cb - 0.468124 * cr, y + 1.8556 * cb), 0.0, 1.0);
}

void put(ivec2 at) {
    if (at.x >= pc.width || at.y >= pc.height) return;
    vec3 rgb = to_rgb(texelFetch(plane_y, at, 0).r, texelFetch(plane_cb, at, 0).r, texelFetch(plane_cr, at, 0).r);
    ivec2 base = at * pc.zoom;
    for (int j = 0; j < pc.zoom; j++)
        for (int i = 0; i < pc.zoom; i++)
            imageStore(dst, base + ivec2(i, j), vec4(rgb.bgr, 1.0));
}

void main() {
    ivec2 at = 2 * ivec2(gl_GlobalInvocationID.xy);
    put(at);
    put(at + ivec2(1, 0));
    put(at + ivec2(0, 1));
    put(at + ivec2(1, 1));
}
